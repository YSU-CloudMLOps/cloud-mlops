# ========================================================
# Cloud MLOps Server Environment Configuration Template
# ========================================================

# [웹 프론트엔드 포트]
FRONTEND_PORT=80

# [FastAPI 백엔드 포트]
BACKEND_PORT=8000

# [머신러닝 추론 모델 설정]
MODEL_PATH=/app/models/lightgbm_model.txt

# 고장 분류 판정 임계값 (0.0 ~ 1.0)
THRESHOLD=0.5

# [AWS CloudWatch & S3 MLOps 로깅 설정]
AWS_REGION=ap-northeast-2
CW_LOG_GROUP=/mlops/predictive-maintenance/inference
CW_LOG_STREAM=api-inference-stream-v2
CW_LOGGING_ENABLED=false
S3_LOG_BUCKET=cloud-mlops-pdm-logs
S3_EXPORT_PREFIX=cloudwatch-exports/retraining-rl
